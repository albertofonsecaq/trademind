# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Environment — never commit real secrets
backend/.env
.env

# Alembic
backend/alembic/versions/__pycache__/

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo

# Database dumps — irreplaceable data, far too large for git, and a dump of a
# production-ish database has no business in version control anyway. See
# backups/README.md.
backups/*.dump
backups/*.sql
backups/*.gz

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Claude Code local settings (personal, not shared)
.claude/settings.local.json
