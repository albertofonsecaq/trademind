# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trademind_app:trademind@localhost:5432/trademind
# Migrations only. The owner can change the schema, so nothing that serves
# requests should carry this (#59, docs/adr/0004).
DATABASE_URL_SYNC=postgresql+psycopg2://trademind_owner:trademind@localhost:5432/trademind

# ── Database roles (#59) ──────────────────────────────────────────────────────
# backend/scripts/setup_db_roles.py creates three roles and is safe to re-run.
# It connects as the bootstrap superuser, which is the only role that can hand
# ownership away:
SUPERUSER_DATABASE_URL=postgresql://trademind:trademind@localhost:5432/trademind
# The bootstrap role's name, if the container was created with another:
# POSTGRES_SUPERUSER=trademind
#
# Each role's password. Defaulted for local development, where the database
# listens on loopback and holds nothing until something ingests into it. Set
# all three anywhere else — and then they must match the URLs above.
# TRADEMIND_OWNER_PASSWORD=
# TRADEMIND_APP_PASSWORD=
# TRADEMIND_BACKUP_PASSWORD=
#
# Which role the backup dumps as. It needs to read every table and create its
# own throwaway databases, and must not be able to drop the live one:
# BACKUP_DB_USER=trademind_backup

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:5173"]

# ── LLM — Required for ingestion, distillation, Ask, and pattern mining ────────
ANTHROPIC_API_KEY=

# ── YouTube — Required to add YouTube sources ─────────────────────────────────
YOUTUBE_API_KEY=
# Optional: OpenAI Whisper for videos without captions (skipped if unset)
OPENAI_API_KEY=
YOUTUBE_CHUNK_SECONDS=300

# ── Market data / Validation ──────────────────────────────────────────────────
# Optional: Polygon.io for higher rate limits; yfinance used by default (free)
POLYGON_API_KEY=
VALIDATION_WINDOW_DAYS=30
VALIDATION_DECAY_HALF_LIFE_DAYS=180

# ── Alpaca paper trading — Required to submit orders ──────────────────────────
# Get keys at: https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# ── Stripe billing — Required only when billing is active ─────────────────────
# 1. Create a Product + recurring monthly Price in your Stripe Dashboard
# 2. Paste the Price ID (price_xxx) here
# 3. Register the /billing/webhook endpoint in Stripe → Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_PRICE_ID=

# Frontend base URL — used for Stripe redirect URLs
FRONTEND_URL=http://localhost:5173
